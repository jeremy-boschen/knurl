    "test:quick": "bash scripts/test/test.sh --mode check",
    "test:full": "bash scripts/test/test.sh",
    "check:types": "tsc --noEmit",
    "check:lint": "biome lint && cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "check:security": "CHECK_TYPES=0 CHECK_LINT=0 CHECK_FMT_RUST=0 CHECK_CLIPPY=0 CHECK_TEST_FE=0 CHECK_TEST_BE=0 CHECK_AUDIT=1 CHECK_DENY=1 CHECK_GITLEAKS=1 bash scripts/test/check-local.sh",
