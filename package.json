    "build:package": "node scripts/build/portal-package.mjs",
    "git:setup": "bash scripts/dev/setup-git-hooks.sh",
    "git:commit": "node ./node_modules/.bin/commitlint",
    "deps:update": "yarn up \\* && cd src-tauri && cargo update",
