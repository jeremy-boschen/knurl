{
  "name": "knurl",
  "description": "Desktop HTTP client.",
  "private": true,
  "version": "0.1.7",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build/generate-knurl-icon.mjs && vite",
    "test:unit": "bash scripts/test/test-unit.sh",
    "test:e2e": "bash scripts/test/test-e2e.sh",
    "test": "bash scripts/test/test.sh",
    "test:check": "bash scripts/test/test-check.sh",
    "perf:benchmark": "bash scripts/test/test-e2e.sh -- --spec='src-common/e2e/specs/performance.e2e.ts'",
    "perf:report": "node scripts/test/generate-performance-report.mjs",
    "perf": "yarn perf:benchmark && yarn perf:report",
    "generate:knurl-icon": "node scripts/build/generate-knurl-icon.mjs",
    "build": "yarn generate:knurl-icon && tsc && vite build && cd src-tauri && cargo build --release",
    "analyze": "cross-env ANALYZE=1 vite build",
    "typecheck": "tsc --noEmit",
    "check": "bash scripts/test/check-local.sh",
    "format": "biome format --write && cd src-tauri && cargo fmt",
    "lint": "biome lint && cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "tauri": "tauri",
    "portal:package": "node scripts/build/portal-package.mjs",
    "generate:icons": "node scripts/build/generate-icons.mjs",
    "oauth-server": "node scripts/oauth-mock-server.mjs",
    "security": "CHECK_TYPES=0 CHECK_LINT=0 CHECK_FMT_RUST=0 CHECK_CLIPPY=0 CHECK_TEST_FE=0 CHECK_TEST_BE=0 CHECK_AUDIT=1 CHECK_DENY=1 CHECK_GITLEAKS=1 bash scripts/test/check-local.sh",
    "update": "yarn up \\* && cd src-tauri && cargo update",
    "docs:dev": "rm -rf documentation/.astro documentation/dist && node scripts/build/generate-docs-sidebar.mjs && cd documentation && astro dev",
    "docs:build": "rm -rf documentation/.astro documentation/dist && node scripts/build/generate-docs-sidebar.mjs && cd documentation && astro build",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.36.2",
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@icons-pack/react-simple-icons": "^13.8.0",
    "@jeremy-boschen/react-adjustable-panels": "^0.3.2",
    "@lezer/highlight": "^1.2.3",
    "@prettier/plugin-xml": "^3.4.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-cli": "^2.4.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-log": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.2",
    "@uiw/codemirror-themes": "^4.25.3",
    "@uiw/react-codemirror": "^4.25.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "astro": "^5.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cm6-graphql": "^0.2.1",
    "cmdk": "^1.1.1",
    "es-toolkit": "^1.42.0",
    "glob": "^13.0.0",
    "graphql": "^16.12.0",
    "immer": "^10.2.0",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.554.0",
    "openapi3-ts": "^4.5.0",
    "prettier": "^3.6.2",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-draggable": "^4.5.0",
    "react-use": "^17.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "wouter": "^3.7.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/vite": "^4.1.17",
    "@tauri-apps/cli": "^2.9.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser": "^4.0.13",
    "@vitest/browser-playwright": "^4.0.13",
    "@vitest/coverage-istanbul": "^4.0.13",
    "@vitest/coverage-v8": "^4.0.13",
    "@vitest/ui": "^4.0.13",
    "@wdio/cli": "^9.20.1",
    "@wdio/globals": "^9.17.0",
    "@wdio/json-reporter": "^9.20.0",
    "@wdio/local-runner": "^9.20.1",
    "@wdio/logger": "^9.18.0",
    "@wdio/mocha-framework": "^9.20.1",
    "@wdio/spec-reporter": "^9.20.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "execa": "^9.6.0",
    "expect-webdriverio": "^5.5.0",
    "istanbul-api": "^3.0.0",
    "istanbul-lib-coverage": "^3.2.2",
    "jsdom": "^27.2.0",
    "knip": "^5.70.1",
    "lefthook": "^2.0.4",
    "nyc": "^17.1.0",
    "oauth2-mock-server": "^8.2.0",
    "playwright": "^1.56.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "shadcn": "^3.5.0",
    "tailwindcss": "^4.1.17",
    "terser": "^5.44.1",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "type-fest": "^5.2.0",
    "typescript": "^5.9.3",
    "uncovered": "^0.1.1",
    "vite": "^7.2.4",
    "vite-plugin-checker": "^0.11.0",
    "vite-plugin-istanbul": "^7.2.1",
    "vitest": "^4.0.13",
    "vitest-browser-react": "^2.0.2",
    "webdriverio": "^9.20.1",
    "yazl": "^3.3.1"
  },
  "optionalDependencies": {
    "@biomejs/cli-linux-x64": "^2.3.7",
    "@biomejs/cli-win32-x64": "^2.3.7"
  },
  "packageManager": "yarn@4.10.3"
}
