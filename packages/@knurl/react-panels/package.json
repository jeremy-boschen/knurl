{
  "name": "@knurl/react-panels",
  "version": "0.1.0",
  "description": "Lightweight React panel library with pixel and percentage-based sizing",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "react",
    "panels",
    "resize",
    "split-pane",
    "layout",
    "resizable",
    "pixel-sizing",
    "percentage-sizing"
  ],
  "author": "Jeremy Boschen",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeremy-boschen/knurl",
    "directory": "packages/@knurl/react-panels"
  },
  "homepage": "https://github.com/jeremy-boschen/knurl/tree/main/packages/@knurl/react-panels#readme",
  "bugs": {
    "url": "https://github.com/jeremy-boschen/knurl/issues"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "jsdom": "^27.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
