{
  "all": true,
  "include": ["src/**/*.{js,ts,tsx}"],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "src/test",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/index.ts",
    "src/main.tsx"
  ],
  "reporter": [
    "text",
    "html",
    "lcov",
    "json"
  ],
  "report-dir": "coverage",
  "temp-dir": ".nyc_output",
  "lines": 70,
  "functions": 70,
  "branches": 65,
  "statements": 70,
  "check-coverage": false
}
